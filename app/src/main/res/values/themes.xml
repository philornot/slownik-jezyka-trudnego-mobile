<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DayNight parent prevents aggressive force-dark by Android OS.
        forceDarkAllowed="false" is also set in manifest.
        Status bar and Navigation bar colors are controlled dynamically via Compose.
    -->
    <style name="Theme.SlownikJezykaTrudnego" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/sjt_light_bg_app</item>
        <item name="android:navigationBarColor">@color/sjt_light_bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
