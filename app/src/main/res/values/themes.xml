<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DayNight parent prevents aggressive force-dark by Android OS.
        forceDarkAllowed="false" is also set in manifest.
        Status bar and navigation bar colors are managed dynamically via enableEdgeToEdge()
        in MainActivity and Compose WindowInsets — not set statically here (deprecated in API 35+).
        windowLightStatusBar / windowLightNavigationBar control icon tint before Compose draws.
    -->
    <style name="Theme.SlownikJezykaTrudnego" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
